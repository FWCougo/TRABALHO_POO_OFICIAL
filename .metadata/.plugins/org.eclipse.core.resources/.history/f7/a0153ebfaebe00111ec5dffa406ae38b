package veiculos;

public abstract class Veiculo {
    private String modelo;

    public Veiculo(String modelo) {
    	this.modelo = modelo;
    }

    public String getModelo() { return modelo; }
    public abstract String getTipo();

    @Override
    public String toString() {
        return getTipo() + " [Modelo: " + modelo +"]";
    }
}